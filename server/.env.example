# auto = scan serial ports for a GRBL/Ortur laser
# Or set explicitly: COM3 (Windows) / /dev/ttyUSB0 or /dev/ttyACM0 (Linux / Raspberry Pi)
SERIAL_PORT=auto
SERIAL_BAUD=115200
BED_WIDTH_MM=400
BED_HEIGHT_MM=430
# true = bind 0.0.0.0 (phones/tablets on Wi-Fi can open the UI)
LAN_ACCESS=false
PORT=8000
